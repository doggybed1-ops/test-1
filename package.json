{
  "name": "veil-lua-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AST-based Lua source transformations and randomized custom VM compiler",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server/index.js",
    "build": "vite build --config vite.config.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:compat": "node scripts/compat.js",
    "test:scale": "node scripts/scale.js",
    "test:ui": "node scripts/ui-smoke.js",
    "analyze": "node scripts/analyze.js",
    "obfuscate": "node scripts/cli.js"
  },
  "dependencies": {
    "luaparse": "0.3.1"
  },
  "devDependencies": {
    "fengari": "0.1.5",
    "luau-web": "1.4.0",
    "monaco-editor": "0.52.2",
    "playwright": "1.56.1",
    "vite": "7.3.7",
    "wasmoon-lua5.1": "1.18.12"
  }
}
